# Dependencias
node_modules/

# Ambiente — nunca commitar credenciais
.env
.env.local
.env.*.local
apps/*/.env
apps/*/.env.local

# Expo
.expo/
.expo-shared/
web-build/
# Projetos nativos gerados por `expo prebuild` / `expo run:android`
apps/mobile/android/
apps/mobile/ios/
# Idem, quando o comando roda por engano na raiz do monorepo
/android/
/ios/
/app.json

# Build
dist/
dist-electron/
apps/desktop/out/
# Instaladores gerados pelo electron-builder
apps/desktop/release/
release/
# `build/` e saida de compilacao em quase todo lugar, menos em apps/desktop,
# onde e o `buildResources` do electron-builder (icone do executavel).
build/
!apps/desktop/build/
!apps/desktop/build/**

# Chaves de assinatura — nunca commitar
*.jks
*.p12
*.keystore
keystore.properties
# Credenciais locais do EAS (`credentialsSource: local`) — tem a senha do keystore
credentials.json
apps/*/credentials.json
# Builds locais do EAS (`eas build --local`)
apps/mobile/*.apk
apps/mobile/*.aab
apps/mobile/build-*.tar.gz

# Supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# Diversos
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Claude Code — preferencias locais
.claude/settings.local.json
