# ---------------------------------------------------------------------------
# Planner Fofo — variaveis de ambiente
# Copie para .env na raiz do monorepo e preencha com os dados do seu projeto.
#   cp .env.example .env
#
# Somente chaves PUBLICAS ficam aqui. A service_role key NUNCA deve ser
# colocada em app mobile/desktop — ela ignora as policies de RLS.
# ---------------------------------------------------------------------------

# URL do projeto Supabase (Dashboard > Project Settings > Data API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Chave publica anon / publishable (Dashboard > Project Settings > API Keys)
SUPABASE_ANON_KEY=

# --- Espelhos por plataforma -----------------------------------------------
# O Expo so injeta variaveis com prefixo EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=${SUPABASE_URL}
EXPO_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# O Vite so injeta variaveis com prefixo VITE_
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
